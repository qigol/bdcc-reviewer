{
  "name": "kodigo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Qdigo (Q's got your Qs): a modular, self-hosted study site for BDCC",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @kodigo/web --filter @kodigo/server dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "kodigo": "tsx packages/cli/src/index.ts",
    "widgets:doc": "tsx packages/cli/src/index.ts widgets-doc docs/WIDGETS.md",
    "smoke": "pnpm --filter @kodigo/web smoke",
    "anim:preview": "npx --yes hyperframes@0.8.175 preview animations",
    "anim:lint": "npx --yes hyperframes@0.8.175 lint animations && node animations/lint-clips.mjs",
    "anim:render": "node animations/render.mjs",
    "pyodide:fetch": "node scripts/fetch-pyodide.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.0"
  }
}
