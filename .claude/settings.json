{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5-5",
  "effortLevel": "medium",
  "advisorModel": "claude-opus-5-5",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "deny": [
      "Agent(Explore)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/jev-route.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "Jev is routing this task"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/jev-gate.sh",
            "args": [],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
